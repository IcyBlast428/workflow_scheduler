# Production systemd EnvironmentFile. Literal KEY=value only; no export/unset,
# shell expansion, command substitution, or secrets committed to the repository.
# Generate secrets and the administrator password hash before installing.
WFS_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_FIXED_SECRET
WFS_CONNECTIONS_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_FIXED_SECRET
WFS_ADMIN_USERNAME=admin
WFS_ADMIN_PASSWORD_HASH=CHANGE_ME_TO_A_WERKZEUG_PASSWORD_HASH

# Existing production GaussDB/DWS configuration uses Nacos.
# <database>_<schema> resolves gauss.<database>.<schema>.json, group gauss.
WFS_DB_ID=your_database_wfs
WFS_DB_DRIVER=DWS
WFS_NACOS_URL=https://nacos.example.internal/nacos
WFS_NACOS_USERNAME=CHANGE_ME
WFS_NACOS_PASSWORD=CHANGE_ME
WFS_DB_QUERY_TIMEOUT_SECONDS=10

# Shared absolute paths are pinned by the installed units. Custom directories
# must be specified consistently when installing units and deploying releases.
# WFS_TASK_RELEASE_DIR=/data/wfs/shared/data/task-packages
WFS_MAX_ACTIVE_RUNS=20
WFS_MIN_FREE_MB=1024
WFS_LOG_RETENTION_DAYS=90
# WFS_TASK_PUBLISHERS=admin
