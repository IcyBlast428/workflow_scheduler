# Managed by workflow_scheduler/scripts/install_systemd.py
[Unit]
Description=Workflow Scheduler (Web and Scheduler)
Conflicts=wfs-scheduler.service
After=wfs-scheduler.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/data/workflow_scheduler
EnvironmentFile=/data/workflow_scheduler/deploy/root-test/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=WFS_STATE_BACKEND=gauss
Environment=WFS_COOKIE_SECURE=false
UnsetEnvironment=GUNICORN_CMD_ARGS GUNICORN_FD WFS_DB_DIALECT WFS_DEV_RUN_ALL WFS_LOCAL_DB_PATH WFS_POSTGRES_TEST
ExecStartPre="/data/workflow_scheduler/.venv/bin/python" "/data/workflow_scheduler/scripts/check_gauss_platform.py"
ExecStart="/data/workflow_scheduler/.venv/bin/python" "/data/workflow_scheduler/scripts/serve.py" "--project" "/data/workflow_scheduler" "--python" "/data/workflow_scheduler/.venv/bin/python" "--web-host" "0.0.0.0" "--web-port" "8008" "--control-port" "8009" "--data" "/data/workflow_scheduler/data" "--logs" "/data/workflow_scheduler/logs"
ExecStartPost="/data/workflow_scheduler/.venv/bin/python" "/data/workflow_scheduler/scripts/wait_ready.py" "--url" "http://127.0.0.1:8008/api/user/ready" "--timeout" "190"
UMask=0077
NoNewPrivileges=true
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=200
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wfs

[Install]
WantedBy=multi-user.target
