[Unit]
Description=Workflow Scheduler
Requires=wfs-scheduler.service
After=network-online.target wfs-scheduler.service
Wants=network-online.target

[Service]
Type=simple
User=wfs
Group=wfs
EnvironmentFile=/etc/wfs/wfs.env
Environment="WFS_ENV=production"
Environment="WFS_ENABLE_SCHEDULER=false"
Environment="WFS_COOKIE_SECURE=true"
Environment="WFS_SCHEDULER_CONTROL_URL=http://127.0.0.1:8009"
Environment="PYTHONPATH=/data/wfs/current"
Environment="WFS_LOG_DIR=/data/wfs/shared/logs"
Environment="WFS_DATA_DIR=/data/wfs/shared/data"
Environment="PYTHONDONTWRITEBYTECODE=1"
UMask=0077
NoNewPrivileges=true
Environment="ODBCSYSINI=/data/wfs/current/app/config/driver/dws_odbc/etc"
Environment="ODBCINI=/data/wfs/current/app/config/driver/dws_odbc/etc/odbc.ini"
WorkingDirectory=/data/wfs/current
ExecStart=/data/wfs/current/.venv/bin/gunicorn -c gunicorn.conf.py --workers 2 --worker-class gthread --threads 8 --timeout 120 --keep-alive 75 --bind 0.0.0.0:8008 --access-logfile - --error-logfile - run:app
Restart=on-failure
RestartSec=5
SyslogIdentifier=workflow-scheduler
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
