[Unit]
Description=Workflow Scheduler Control Process
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment="WFS_ENV=production"
Environment="WFS_ENABLE_SCHEDULER=true"
Environment="PYTHONPATH=/data/wfs"
Environment="ODBCSYSINI=/data/wfs/app/config/driver/dws_odbc/etc"
Environment="ODBCINI=/data/wfs/app/config/driver/dws_odbc/etc/odbc.ini"
WorkingDirectory=/data/wfs
ExecStart=/data/wfs/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8009 --access-logfile - --error-logfile - run:app
Restart=on-failure
RestartSec=5
SyslogIdentifier=workflow-scheduler-control
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
